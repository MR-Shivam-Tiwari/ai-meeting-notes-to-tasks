        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You summarise meetings. Reply with JSON only: {title: string, summary: string, decisions: string[], tasks: [{task: string, owner: string, due: string}]}. Use only facts stated in the transcript; if an owner or date is not stated, use 'Unassigned' / 'No date'.\" },\n    { \"role\": \"user\", \"content\": \"Meeting title: {{ $json.body.title }}\\n\\nTranscript:\\n{{ $json.body.transcript }}\" }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "cd2ce074-af73-4752-ad9e-b9b7be846495",
      "name": "AI Summarise & Extract Tasks (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nconst ai = JSON.parse(raw);\nreturn ai.tasks.map(t => ({ json: { meeting: ai.title, summary: ai.summary, decisions: ai.decisions.join('; '), task: t.task, owner: t.owner, due: t.due, created_at: new Date().toISOString() } }));"
      },
